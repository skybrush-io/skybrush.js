{
  "name": "@skybrush/electron-app-updater-integration",
  "version": "1.0.0",
  "description": "Integration of electron-updater with Skybrush desktop applications",
  "author": "CollMot Robotics Ltd",
  "type": "module",
  "homepage": "",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./main": {
      "import": "./dist/main/index.js",
      "types": "./dist/main/index.d.ts"
    },
    "./preload": {
      "import": "./dist/preload/index.js",
      "types": "./dist/preload/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.collmot.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skybrush-io/skybrush.js.git"
  },
  "scripts": {
    "build": "npx tsc",
    "clean": "rimraf dist/** *.tgz",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "electron": ">=39.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "electron": "^42.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@skybrush/electron-app-framework": "^5.2.1",
    "@skybrush/mui-components": "^6.7.0",
    "electron-better-ipc": "^2.0.1",
    "electron-updater": "^6.8.9",
    "react-redux": "^9.3.0",
    "redux-saga": "^1.5.0",
    "tiny-typed-emitter": "^2.1.0"
  }
}
